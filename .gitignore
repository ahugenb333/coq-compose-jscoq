# --- Gradle (keep gradle/wrapper/* tracked) ---
.gradle/
**/.gradle/
build/
**/build/
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

local.properties
gradle-local.properties
*.iml
.kotlin/

# --- Android Studio / IntelliJ ---
.idea/
*.ipr
*.iws
.cxx/
.externalNativeBuild/
captures/

# --- Android build outputs ---
*.apk
*.aab
*.ap_
*.dex
*.hprof

# --- iOS / Xcode ---
**/Pods/
DerivedData/
*.xcuserstate
**/xcuserdata/
*.dSYM/
*.dSYM.zip
*.ipa
*.hprof

# Track Xcode project structure, ignore user-specific state
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
!*.xcodeproj/project.xcworkspace/
!*.xcworkspace/contents.xcworkspacedata
**/xcshareddata/WorkspaceSettings.xcsettings

# --- Kotlin Multiplatform / Native ---
*.klib
*.kexe

# --- jsCoq assets (copy locally; see assets/jscoq/README.md) ---
*.wasm
**/assets/jscoq/**
!**/assets/jscoq/README.md

# --- Node (future JS/Wasm targets) ---
node_modules/

# --- Secrets & signing ---
*.jks
*.keystore
*.env
.env
signing.properties
/fabric.properties

# --- OS junk ---
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini

# --- Logs & temp ---
*.log
*.tmp
*.bak
*.orig
*.rej
*.swp
*.swo

# --- Editor ---
.vscode/
